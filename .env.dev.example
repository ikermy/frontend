# Local development environment (copy to .env to override defaults)
# Used by docker-compose.dev.yml

# --- BFF (auth и защищённые маршруты через /api/v1) ---
# Относительный base URL — /api/v1/* проксируется vite-dev-server'ом на BFF
# (см. nuxt.config.ts vite.server.proxy, target http://bff:8080).
NUXT_PUBLIC_API_BASE_URL=/api/v1
# real — обращаться к реальным сервисам через прокси
# mock  — вернуть фиктивные данные без обращения к сервисам
NUXT_PUBLIC_API_MODE=real
# Цель прокси BFF (docker-сеть barcode_shared)
NUXT_PROXY_API_TARGET=http://bff:8080

# --- Прямые сервисы (vite-proxy в dev; в проде — через Envoy/прямые docker-имена) ---
# Префиксы /barcodegen, /billing, /ai, /history (см. api.config.ts serviceURLs)
NUXT_PUBLIC_BARCODEGEN_URL=/barcodegen
NUXT_PUBLIC_BILLING_URL=/billing
NUXT_PUBLIC_AI_URL=/ai
NUXT_PUBLIC_HISTORY_URL=/history
# Цели прокси (docker-имена сервисов)
NUXT_PROXY_BARCODEGEN_TARGET=http://barcodegen:8080
NUXT_PROXY_BILLING_TARGET=http://billing:3000
NUXT_PROXY_AI_TARGET=http://ai-service:8080
NUXT_PROXY_HISTORY_TARGET=http://history:3000

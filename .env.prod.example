# Copy to .env on the server at: ~/barcode/front/.env
# Used by docker-compose.prod.yml on the VPS.

# --- Docker image to pull (GitHub Container Registry) ---
REGISTRY=ghcr.io
IMAGE=ikermy/frontend
TAG=prod

# --- Application (runtime variables) ---
# Single origin via Envoy: front and API share the same domain, so use a relative path.
DOMAIN=example.com
NUXT_PUBLIC_API_BASE_URL=/api/v1
NUXT_PUBLIC_API_MODE=mock

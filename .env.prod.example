# Production build values for the frontend image.
# These are BUILD-TIME args (Nuxt statically inlines NUXT_PUBLIC_* into the SPA).
# In CI they are supplied via repository Actions Variables; see .github/workflows.

# Single origin via ingress (Traefik): frontend and API share the same domain.
NUXT_PUBLIC_API_BASE_URL=/api/v1
# real — call real services via /api/v1; mock — return fake data.
NUXT_PUBLIC_API_MODE=real
# Telegram login widget (bot username without @, and post-login redirect URL).
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=kermyauthbot
NUXT_PUBLIC_TELEGRAM_AUTH_URL=https://v997893.hosted-by-vdsina.com/auth/telegram/callback

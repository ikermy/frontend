# Development image: runs `nuxt dev` with hot reload.
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Copy manifest files first for better layer caching
COPY package.json package-lock.json* ./
RUN npm install

# Copy the rest of the project
COPY . .

EXPOSE 3002

# Nuxt listens on 0.0.0.0 inside the container
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3002

CMD ["npm", "run", "dev"]
